# =============================================================
# Gestão de Igreja — configuração on-premise
# Copie para `.env` e ajuste os valores.
# =============================================================

# --- SQLite (dados do próprio app: membros, finanças, eventos, inscrições) ---
SQLITE_PATH=./data/dashboard.db

# --- Login com Google (membros) -------------------------------
# Crie em https://console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application.
# Em "Authorized redirect URIs", cadastre EXATAMENTE o valor de
# GOOGLE_REDIRECT_URI abaixo (troque pelo domínio/porta real em produção).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/entrar/callback

# --- Segredo da sessão (cookie criptografado). >= 32 chars. ------
# Gere um novo:  openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-de-32-chars

# --- Porta do app (interna) ---
PORT=3000

# --- Ambiente ---
NODE_ENV=production

# --- Cookie de sessão exige HTTPS quando ligado. Se você acessa o app
# por http:// (rede local, sem certificado), deixe "false" — senão o
# navegador descarta o cookie de login silenciosamente e o login parece
# "não fazer nada". Só mude pra "true" se tiver HTTPS configurado na
# frente (nginx/Caddy/proxy reverso). ---
COOKIE_SECURE=false
